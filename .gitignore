# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Project specific
.env
.stage-check/
build/
*.log
*.log.err
.server.pid
.frontend.pid
.demo-backend.pid
.demo-tunnel.pid
.coverage

# Frontend (v2)
frontend/node_modules/
frontend/dist/

# Database files (regenerate from seed files instead)
dnd_kids_resources.db
*.db
*.db-shm
*.db-wal

# Database backups (old versions)
*.db.backup.*

# Ignore local data and 5eTools data that should not be added to GitHub.
# Written as `/data/*` rather than `/data/` so that individual files can be
# re-included below; git cannot un-ignore anything inside an excluded directory.
/data/*
/data/5eTools/

data/seeds/archive/

# The generated export schema is committed: CI runs
# `generate_export_schema.py --check` against it on a fresh checkout.
# It contains table and column names only — no campaign content.
!/data/generated/
/data/generated/*
!/data/generated/export_schema.json


# Dispatch-time work-order snapshots. Transient by design: written by
# `order_telemetry.py --snapshot`, consumed when the order reports back, and cleared at
# cycle close. The durable record is docs/plans/telemetry.jsonl.
.telemetry/

# Our own skills live in `.claude/skills/` because that is the only place Claude
# Code discovers project skills, and opencode reads it too — so one tracked copy
# serves both harnesses and every clone gets the slash commands with no setup.
# Everything else in the directory is a local link to a vendored skill under
# `.agents/skills/`; those are not project code. Written as `.claude/skills/*`
# rather than `.claude/skills/` so the exceptions below can re-include ours.
.claude/skills/*
!.claude/skills/plan/
!.claude/skills/to-orders/
!.claude/skills/dispatch-orders/
!.claude/skills/implement-order/
!.claude/skills/reconcile/
!.claude/skills/ux-design/

# Machine-local Claude Code permissions. `.claude/settings.json` is deliberately
# tracked: it wires the read guard, and an untracked rule silently stops applying
# on the next clone.
.claude/settings.local.json

# Vendored skill dirs for other tools (not project code)
.cursor/skills/
# Vendored skills kept on disk for local use. Ones added before this rule stay
# tracked; the rule keeps new vendored drops out of the repo.
.agents/skills/*
# Ignore opencode's working dir, but track our own plugins. The read guard is a
# workflow rule, and an untracked rule silently stops applying on the next clone —
# the same trap `dispatch-orders` fell into.
.opencode/*
!.opencode/plugin/
opencode.json
