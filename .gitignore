# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Project specific
.env
.stage-check/
build/
*.log
*.log.err
.coverage

# Frontend (v2)
frontend/node_modules/
frontend/dist/
frontend/playwright-report/
frontend/test-results/

# Database files (regenerate from seed files instead)
dnd_kids_resources.db
*.db
*.db-shm
*.db-wal

# Database backups (old versions)
*.db.backup.*

# Ignore local data and 5eTools data that should not be added to GitHub.
# Written as `/data/*` rather than `/data/` so that individual files can be
# re-included below; git cannot un-ignore anything inside an excluded directory.
/data/*
/data/5eTools/
data/seeds/seed_monsters.json

data/seeds/archive/

# The generated export schema is committed: CI runs
# `generate_export_schema.py --check` against it on a fresh checkout.
# It contains table and column names only — no campaign content.
!/data/generated/
/data/generated/*
!/data/generated/export_schema.json

# Claude Code's machine-local directory: settings, vendored skill links, and
# per-machine state. No tracked Claude assets remain — the project skills moved
# to `.opencode/skills/` and the read guard is opencode-only — so ignore it whole.
.claude/

# Vendored skill dirs for other tools (not project code)
.cursor/skills/
# Vendored skills kept on disk for local use. Ones added before this rule stay
# tracked; the rule keeps new vendored drops out of the repo.
.agents/skills/*
# Ignore opencode's working dir, but track our own plugins and skills.
.opencode/*
!.opencode/plugin/
!.opencode/skills/
!.opencode/tools/
!.opencode/agents/
!.opencode/agents/**
opencode.json
